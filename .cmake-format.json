{
  "format": {
    "line_width": 120,
    "tab_size": 4,
    "use_tabchars": false,
    "dangle_parens": true,
    "dangle_align": "prefix-indent",
    "max_subgroups_hwrap": 1,
    "max_pargs_hwrap": 8,
    "separate_ctrl_name_with_space": true,
    "separate_fn_name_with_space": false,
    "command_case": "unchanged",
    "keyword_case": "unchanged",
    "max_lines_hwrap": 4,
    "min_prefix_chars": 4,
    "max_prefix_chars": 10,
    "enable_sort": false,
    "autosort": false
  },
  "markup": {
    "enable_markup": false
  },
  "parse": {
    "additional_commands": {}
  },
  "encode": {
    "emit_byteorder_mark": false
  }
}
